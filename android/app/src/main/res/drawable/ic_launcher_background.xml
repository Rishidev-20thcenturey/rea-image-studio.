<?xml version="1.0" encoding="utf-8"?>
<!-- REA Image Studio launcher icon: the background plate. A deep indigo-to-black radial gradient,
     warm at the centre so the light foreground squares keep their contrast on any wallpaper. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0 H108 V108 H0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="44"
                android:gradientRadius="76"
                android:startColor="#FF232042"
                android:centerColor="#FF171528"
                android:endColor="#FF0B0A12" />
        </aapt:attr>
    </path>
</vector>
